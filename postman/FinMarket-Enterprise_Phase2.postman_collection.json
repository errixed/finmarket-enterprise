        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Phase II test campaign\",\n  \"strategy\": \"NEWSLETTER\",\n  \"channel\": \"EMAIL\",\n  \"templateId\": \"{{templateId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"campaignId\", pm.response.json().data._id);"
            ]
          }
        }
      ]
