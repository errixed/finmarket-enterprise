{
  "info": {
    "name": "FinMarket Phase II Campaigns",
    "description": "Run in order after shared JWT and DB-backed Identity fixtures are available. Specialist relationship must be ACCEPTED; specialist must start unassigned. Expected 401 on invalid JWT depends on shared middleware.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "advisorToken",
      "value": ""
    },
    {
      "key": "otherAdvisorToken",
      "value": ""
    },
    {
      "key": "specialistToken",
      "value": ""
    },
    {
      "key": "specialistUserId",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "invalid"
    },
    {
      "key": "templateId",
      "value": ""
    },
    {
      "key": "campaignId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create template",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/campaigns/templates",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{advisorToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phase II test\",\n  \"channel\": \"EMAIL\",\n  \"body\": \"Test marketing message\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"templateId\", pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create campaign",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
